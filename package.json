{
  "name": "wyreanderson-portfolio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "format": "prettier --write src tests *.ts *.mjs *.json .github/workflows/ci.yml README.md docs/ARCHITECTURE.md docs/DEPLOYMENT.md docs/QA.md",
    "format:check": "prettier --check src tests *.ts *.mjs *.json .github/workflows/ci.yml README.md docs/ARCHITECTURE.md docs/DEPLOYMENT.md docs/QA.md"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/pixelify-sans": "5.3.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": "24.x"
  }
}
